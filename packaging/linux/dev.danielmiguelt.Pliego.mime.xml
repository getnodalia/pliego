<?xml version="1.0" encoding="UTF-8"?>
<!-- Installed as share/mime/packages/dev.danielmiguelt.Pliego.xml (package.sh, the Flatpak
     manifests). Both formats are zip files, so they are matched by extension: zip magic would
     claim every archive. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-pliego">
    <comment>Pliego document</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="dev.danielmiguelt.Pliego"/>
    <glob pattern="*.pliego"/>
    <glob pattern="*.designcraft"/> <!-- rebrand: keep (saved before the rename) -->
  </mime-type>
  <mime-type type="application/vnd.adobe.indesign-idml-package">
    <comment>IDML document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.idml"/>
  </mime-type>
</mime-info>
